# Copy to .env and replace placeholders. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///campusflow.db
# For MySQL instead, create the database and account first, then use:
# DATABASE_URL=mysql+pymysql://campusflow:password@127.0.0.1:3306/campusflow?charset=utf8mb4
SESSION_COOKIE_SECURE=false
FLASK_APP=backend.app
FLASK_DEBUG=false
